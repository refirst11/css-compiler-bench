{
  "name": "css-compiler-benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --dir scoreboard dev",
    "build": "pnpm --dir scoreboard build",
    "preview": "pnpm --dir scoreboard preview",
    "bench": "node scripts/benchmark.ts",
    "fixture": "node scripts/fixture.ts",
    "bench:scale": "node scripts/scale.ts",
    "bench:binding": "node scripts/binding.ts",
    "structure": "node scripts/structure.ts",
    "measure": "pnpm bench && pnpm fixture && pnpm bench:scale && pnpm bench:binding && pnpm structure --client",
    "typecheck": "tsc --noEmit -p tsconfig.benchmark.json && pnpm --dir scoreboard run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5"
  }
}
